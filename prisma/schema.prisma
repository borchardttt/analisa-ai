generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  players     Player[]  // relação 1:N com Player
}

model Player {
  id       Int      @id @default(autoincrement())
  name     String
  age      Int
  position String?
  teamId   Int
  team     Team     @relation(fields: [teamId], references: [id])
}
